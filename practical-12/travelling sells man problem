
from itertools import permutations

n = int(input("Enter number of cities: "))

cities = []

for i in range(n):
    city = input("Enter city name: ")
    cities.append(city)

graph = []

print("Enter distance between cities:")

for i in range(n):
    row = list(map(int, input().split()))
    graph.append(row)

start = 0
other = list(range(1, n))

min_cost = float('inf')
best_path = []

for path in permutations(other):
    route = [start] + list(path) + [start]
    cost = 0

    for i in range(len(route) - 1):
        cost += graph[route[i]][route[i + 1]]

    if cost < min_cost:
        min_cost = cost
        best_path = route

print("\nShortest Route:")

for i in best_path:
    print(cities[i], end=" ")

print("\nMinimum Distance:", min_cost)
